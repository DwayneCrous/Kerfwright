---
const cols = [
  ['Documentation', [
    ['Introduction', '/docs/getting-started/introduction/'],
    ['Build from source', '/docs/getting-started/build-from-source/'],
    ['Your first part', '/docs/getting-started/first-part/'],
    ['Workspaces', '/docs/workspaces/design/'],
  ]],
  ['Internals', [
    ['Crate map', '/docs/architecture/crate-map/'],
    ['The .kwf file', '/docs/architecture/kwf-format/'],
    ['Threading and jobs', '/docs/architecture/threading/'],
    ['Benchmarks', '/docs/benchmarks/results/'],
  ]],
  ['Project', [
    ['Status and limits', '/docs/project/status-and-limits/'],
    ['Clean-room policy', '/docs/project/clean-room/'],
    ['Source on GitHub', 'https://github.com/DwayneCrous/Kerfwright'],
    ['Roadmap', 'https://github.com/DwayneCrous/Kerfwright/blob/main/docs/04-roadmap.md'],
  ]],
] as const;
---
<footer class="border-t border-rule">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.3fr_repeat(3,1fr)]">
    <div>
      <p class="flex items-center gap-2.5 font-display text-lg font-semibold">
        <img src="/favicon.svg" alt="" width="24" height="24" class="size-6" /> Kerfwright
      </p>
      <p class="mt-3 max-w-xs text-[.9375rem] text-soft">
        A CAD, CAM, FEA and ECAD suite written in Rust, built clean-room from public sources. Pre-release.
      </p>
    </div>
    {cols.map(([title, links]) => (
      <nav aria-label={title}>
        <p class="label">{title}</p>
        <ul class="mt-3 space-y-1">
          {links.map(([l, h]) => <li><a href={h} class="inline-flex min-h-8 items-center text-[.9375rem] text-soft hover:text-ink">{l}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-rule">
    <p class="mx-auto max-w-6xl px-5 py-5 text-[.875rem] text-soft">
      Kerfwright is not affiliated with or endorsed by Autodesk, Siemens, Spatial or any CAD vendor. A project by weopensourcesoftware.
    </p>
  </div>
</footer>
