---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

const repo = 'https://github.com/DwayneCrous/Kerfwright/blob/main/docs';

// Each row of the evidence table: what was measured, and the sentence that stops it being over-read.
// Sources: docs/phase1-report.md … phase5-report.md (every figure and caveat below is quoted from them).
const evidence = [
  { area: 'Viewport', result: '1,003,424 triangles with edges, OIT and ambient occlusion: 2.59 ms p95 GPU time at 1080p.',
    caveat: 'One laptop integrated GPU (Radeon 860M). The PRD never defined a reference GPU.', src: 'phase5-report.md', n: 'Phase 5' },
  { area: 'Sketch drag', result: 'p99 0.22 ms per frame on a 493-entity sketch.',
    caveat: 'Holds for sketches that split into small blocks. A sketch chained entity-to-entity is p99 8.6 ms.', src: 'phase2-report.md', n: 'Phase 2' },
  { area: 'Boolean operations', result: '100,000 operand pairs × 3 operations: 0 invalid results, 0 panics, 99.90 % succeed on cases expected to be valid.',
    caveat: 'One fuzz seed (34267) where an independent check and a free-form result disagree. The cause is not found.', src: 'phase3-report.md', n: 'Phase 3' },
  { area: 'Persistent names', result: '1,716 edit scenarios: 0 silently wrong, 99.88 % resolved or correctly flagged as gone.',
    caveat: 'The corpus is generated, and the thresholds were tuned on the same generator.', src: 'phase4-report.md', n: 'Phase 4' },
  { area: 'Incremental rebuild', result: '200-feature, 8-part model: 335 ms cold replay, 53 ms for an edit near the end.',
    caveat: 'One chain of 100 Booleans takes 8.7 s cold. That target is not met.', src: 'phase4-report.md', n: 'Phase 4' },
  { area: 'Toolpath verification', result: '0 gouges and 0 holder collisions on 21 parts, checked by two independent checkers.',
    caveat: 'The checkers were written in this project, and the machine housing is not modelled.', src: 'phase5-report.md', n: 'Phase 5' },
  { area: 'Finite elements', result: 'Cantilever tip deflection −0.015 % against the closed-form answer. One million DOF solved in 81 s.',
    caveat: 'References are closed-form elasticity solutions. The million-DOF run uses a structured mesh.', src: 'phase5-report.md', n: 'Phase 5' },
  { area: 'Board routing', result: '1,023 of 1,023 nets routed with 0 DRC violations on 20 boards.',
    caveat: 'Generated benchmark boards. The DRC and both Gerber viewers were written in this project.', src: 'phase5-report.md', n: 'Phase 5' },
];

const workspaces = [
  { name: 'Design', body: 'Constrained sketches, extrude, revolve, sweep, loft, fillet, shell, patterns, assemblies with joints, sheet metal, subdivision forms and surfaces.',
    engines: 'kw-sketch · kw-model · kw-feature · kw-assembly', href: '/docs/workspaces/design/' },
  { name: 'Manufacture', body: 'Setups with stock and work coordinates, pocket, contour, drill, 3-D finishing, stock simulation and five G-code dialects.',
    engines: 'kw-cam · kw-gsim', href: '/docs/workspaces/manufacture/' },
  { name: 'Simulation', body: 'Supports and loads picked on faces, static and modal studies, topology optimisation, results coloured on the model.',
    engines: 'kw-mesh3d · kw-fem', href: '/docs/workspaces/simulation/' },
  { name: 'Electronics', body: 'Place, route, check and pour a board, then write Gerber, Excellon, IDF, STEP and pick-and-place files. Sample boards only so far.',
    engines: 'kw-ecad · kw-fabcheck', href: '/docs/workspaces/electronics/' },
  { name: 'Render', body: 'Real-time viewport or progressive path tracing with a denoiser. Save a PNG when it converges.',
    engines: 'kw-render', href: '/docs/workspaces/render/' },
  { name: 'Drawings', body: 'Sheets with base, projected, section and detail views, dimensions with tolerances, GD&T symbols, parts lists and PDF or DXF output.',
    engines: 'kw-drawing', href: '/docs/workspaces/drawings/' },
];
---
<Landing
  title="Kerfwright | CAD, CAM, FEA and ECAD in Rust"
  description="An open-source CAD, CAM, FEA and ECAD suite on its own B-rep kernel, written in Rust. One .kwf file carries the sketches, history, toolpaths, studies and board."
>
  <Nav />
  <main id="main">
    <Hero />

    <!-- Overview ──────────────────────────────────────────── -->
    <section id="overview" class="mx-auto max-w-6xl border-t border-rule px-5 py-20">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
        <div>
          <p class="label">Overview</p>
          <h2 class="h2 mt-3">One file holds the whole job.</h2>
          <p class="lead mt-5">
            A Kerfwright project is a single <code class="font-mono text-[.9em]">.kwf</code> file. The design history sits
            at the centre. Toolpaths, studies and boards are stored next to it and refer back to it, so editing a
            dimension can update everything built on it.
          </p>
          <p class="mt-4 max-w-xl text-soft">
            The engine is built around three promises that the project tests rather than asserts.
          </p>
        </div>

        <!-- The structure of a .kwf, drawn as a ruled stack. -->
        <figure class="sheet m-0 text-[.9375rem]" aria-label="Structure of a .kwf project file">
          <div class="grid grid-cols-[7.5rem_1fr] border-b border-rule">
            <div class="label border-r border-rule p-4">Inputs</div>
            <div class="p-4">Sketches with dimensions and constraints, and named <span class="font-mono text-[.9em]">parameters</span> that any value can use.</div>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] border-b border-rule">
            <div class="label border-r border-rule p-4">History</div>
            <div class="p-4">An ordered <strong class="font-medium">feature timeline</strong>: extrude, revolve, fillet, shell, hole, pattern, joint. Each feature is cached by what it reads.</div>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr] border-b border-rule">
            <div class="label border-r border-rule p-4">Attached</div>
            <div class="grid gap-px p-0 sm:grid-cols-3">
              <div class="p-4"><span class="font-mono text-[.875rem]">cam.cbor</span><br /><span class="text-soft">setups, stock, operations, posts</span></div>
              <div class="p-4 sm:border-l sm:border-rule"><span class="font-mono text-[.875rem]">fea.cbor</span><br /><span class="text-soft">studies, supports, loads, results</span></div>
              <div class="p-4 sm:border-l sm:border-rule"><span class="font-mono text-[.875rem]">board.cbor</span><br /><span class="text-soft">the ECAD board</span></div>
            </div>
          </div>
          <div class="grid grid-cols-[7.5rem_1fr]">
            <div class="label border-r border-rule p-4">Outputs</div>
            <div class="p-4 text-soft">STEP, IGES, STL, OBJ, glTF, DXF, PDF, G-code, Gerber, Excellon, IDF.</div>
          </div>
        </figure>
      </div>

      <div class="mt-16 grid gap-px border border-rule bg-[var(--kw-rule)] md:grid-cols-3">
        <article class="reveal bg-paper p-6">
          <h3 class="font-display text-xl font-semibold">Rebuild only what changed</h3>
          <p class="mt-3 text-soft">Every feature's result is cached under a hash of everything it reads. An edit re-runs that feature and what depends on it. If a re-run produces the same output, its dependents are left alone.</p>
          <p class="mt-4"><a class="link" href="/docs/concepts/parametric-engine/">How the engine rebuilds</a></p>
        </article>
        <article class="reveal bg-paper p-6">
          <h3 class="font-display text-xl font-semibold">Names that survive edits</h3>
          <p class="mt-3 text-soft">A face is named by how it was made, not where it is. A fillet stays on its edge after you add a feature upstream, and a reference that cannot be resolved is reported instead of guessed.</p>
          <p class="mt-4"><a class="link" href="/docs/concepts/topological-naming/">How names are resolved</a></p>
        </article>
        <article class="reveal bg-paper p-6">
          <h3 class="font-display text-xl font-semibold">The same answer on any machine</h3>
          <p class="mt-3 text-soft">Sketch solves and feature rebuilds give identical geometry and names on 1, 4 or 32 threads. Parallelism splits independent work and never reduces floating-point sums across threads.</p>
          <p class="mt-4"><a class="link" href="/docs/concepts/determinism/">Why that holds</a></p>
        </article>
      </div>
    </section>

    <!-- Workspaces ────────────────────────────────────────── -->
    <section id="workspaces" class="mx-auto max-w-6xl border-t border-rule px-5 py-20">
      <p class="label">Workspaces</p>
      <h2 class="h2 mt-3 max-w-2xl">Every discipline works on the same model.</h2>
      <p class="lead mt-5">Switch workspace from the ribbon and the model stays where it is. Each one is a guide in the documentation.</p>

      <ul class="mt-10 border-t border-rule-strong" style="border-color: var(--kw-rule-strong)">
        {workspaces.map((w) => (
          <li class="border-b border-rule">
            <a href={w.href} class="group grid gap-x-8 gap-y-2 py-6 md:grid-cols-[10rem_minmax(0,1fr)_14rem] md:items-baseline">
              <h3 class="font-display text-2xl font-semibold group-hover:text-dykem">{w.name}</h3>
              <p class="text-soft">{w.body}</p>
              <p class="font-mono text-[.8125rem] text-soft md:text-right">{w.engines}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Evidence ──────────────────────────────────────────── -->
    <section id="evidence" class="mx-auto max-w-6xl border-t border-rule px-5 py-20">
      <p class="label">Evidence</p>
      <h2 class="h2 mt-3 max-w-2xl">Measured results, with what they do not show.</h2>
      <p class="lead mt-5">
        Each row is quoted from a phase report, with the caveat that stops the number being read as more than it is.
      </p>

      <div class="mt-10 overflow-x-auto">
        <table class="data evidence">
          <caption class="sr-only">Measured results and their caveats</caption>
          <thead>
            <tr><th scope="col" class="w-40">Area</th><th scope="col">Measured</th><th scope="col">Read it with this</th><th scope="col" class="w-28">Source</th></tr>
          </thead>
          <tbody>
            {evidence.map((e) => (
              <tr>
                <th scope="row" class="!border-b !border-rule !py-4 !text-ink !font-medium !font-sans !text-[.9375rem]" data-label="Area">{e.area}</th>
                <td data-label="Measured">{e.result}</td>
                <td class="text-soft" data-label="Read it with this">{e.caveat}</td>
                <td data-label="Source"><a class="link" href={`${repo}/${e.src}`}>{e.n}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-soft">The full tables, targets and reproduction commands are on the <a class="link" href="/docs/benchmarks/results/">benchmark page</a>.</p>
    </section>

    <!-- Status ────────────────────────────────────────────── -->
    <section id="status" class="mx-auto max-w-6xl border-t border-rule px-5 py-20">
      <p class="label">Status</p>
      <h2 class="h2 mt-3 max-w-2xl">What works today, and what does not.</h2>

      <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <h3 class="font-display text-xl font-semibold">Working</h3>
          <ul class="mt-4 space-y-3 text-soft">
            <li>Phases 1 to 5 of the roadmap: kernel, sketcher and solver, parametric engine, CAM, FEA, ECAD and rendering, each with its acceptance results.</li>
            <li>The desktop app: welcome page, projects, six workspaces, ribbon, browser tree and timeline.</li>
            <li>Import of STEP, IGES, STL and DXF. Export of STEP, STL, OBJ, GLB, DXF, PDF, Gerber and Excellon.</li>
          </ul>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold"><span class="text-scribe">Not done</span></h3>
          <ul class="mt-4 space-y-3 text-soft">
            <li>Installers. You build from source.</li>
            <li>Phase 6: collaboration, a WASM client and hardening.</li>
            <li>Testing on Windows and macOS. Development and testing so far were on Linux.</li>
            <li>G-code posts have not run on a real controller. The simulators that check them were written here.</li>
            <li>Adaptive clearing is withheld from the default build until its patent review is recorded.</li>
            <li>Heavy models are evaluated on the UI thread and can pause the window.</li>
          </ul>
        </div>
      </div>
      <p class="mt-10"><a class="link" href="/docs/project/status-and-limits/">Every known limit, by area</a></p>
    </section>

    <!-- Start ─────────────────────────────────────────────── -->
    <section class="mx-auto max-w-6xl border-t border-rule px-5 py-20">
      <h2 class="h2 max-w-2xl">Start with the documentation.</h2>
      <div class="mt-8 grid gap-px border border-rule bg-[var(--kw-rule)] md:grid-cols-3">
        <a href="/docs/getting-started/build-from-source/" class="block bg-paper p-6 hover:bg-panel">
          <span class="font-display text-xl font-semibold">Build from source</span>
          <span class="mt-2 block text-soft">Toolchain, GPU requirements, flags and the test scripts.</span>
        </a>
        <a href="/docs/getting-started/first-part/" class="block bg-paper p-6 hover:bg-panel">
          <span class="font-display text-xl font-semibold">Make your first part</span>
          <span class="mt-2 block text-soft">Sketch, constrain, extrude, edit a dimension and watch the timeline rebuild.</span>
        </a>
        <a href="/docs/architecture/crate-map/" class="block bg-paper p-6 hover:bg-panel">
          <span class="font-display text-xl font-semibold">Read the architecture</span>
          <span class="mt-2 block text-soft">Crate layers, the threading model and the rules that keep the kernel clean.</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />

  <style is:global>
    /* Below 768 px each evidence row becomes a labelled block instead of a table that scrolls sideways. */
    @media (max-width: 767px) {
      .evidence thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      .evidence, .evidence tbody, .evidence tr, .evidence th, .evidence td { display: block; }
      .evidence tr { border-bottom: 1px solid var(--kw-rule); padding: 1rem 0; }
      .evidence th[scope='row'] { padding: 0 0 .25rem !important; border: 0 !important; }
      .evidence td { border: 0; padding: .25rem 0; }
      .evidence td::before { content: attr(data-label); display: block; font-family: var(--font-mono); font-size: .75rem; color: var(--kw-soft); }
    }
  </style>
</Landing>
