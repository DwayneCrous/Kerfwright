# Haas VF series (Fanuc-like with Haas program header and accuracy control)
name = Haas
decimals = 4
trim = zeros
line_numbers = "N{n} "
line_start = 1
line_step = 1
comment = ({text})
modal = true
program_start = @%\n@O{program}\n@({name})\nG21 G90 G94 G17 G40 G49 G80\nG187 P1
program_end = M05\nG91 G28 Z0.\nM30\n@%
tool_change = T{tool} M06\nG43 H{tool}
spindle_on_cw = S{rpm} M03
spindle_on_ccw = S{rpm} M04
spindle_off = M05
coolant_on = M08
coolant_off = M09
rapid = G00 {X} {Y} {Z}
feed = G01 {X} {Y} {Z} {F}
arc_cw = G02 {X} {Y} {Z} {I} {J} {F}
arc_ccw = G03 {X} {Y} {Z} {I} {J} {F}
drill_start = G81 {X} {Y} {Z} {R} {F}
drill_peck_start = G83 {X} {Y} {Z} {R} {Q} {F}
drill_at = {X} {Y}
drill_end = G80
rapid5 = G00 {X} {Y} {Z} {A} {B} {C}
feed5 = G01 {X} {Y} {Z} {A} {B} {C} {F}
tcp_on = G234 H{tool}
tcp_off = G49
work_offset = G{wcs}
