# LinuxCNC (RS-274/NGC)
name = LinuxCNC
decimals = 4
trim = zeros
line_numbers =
comment = ({text})
modal = true
program_start = @%\n({name})\nG21 G90 G94 G17 G40 G49 G54 G64 P0.01
program_end = M05\nM2\n@%
tool_change = T{tool} M6\nG43 H{tool}
spindle_on_cw = S{rpm} M3
spindle_on_ccw = S{rpm} M4
spindle_off = M5
coolant_on = M8
coolant_off = M9
rapid = G0 {X} {Y} {Z}
feed = G1 {X} {Y} {Z} {F}
arc_cw = G2 {X} {Y} {Z} {I} {J} {F}
arc_ccw = G3 {X} {Y} {Z} {I} {J} {F}
drill_start = G81 {X} {Y} {Z} {R} {F}
drill_peck_start = G83 {X} {Y} {Z} {R} {Q} {F}
drill_at = {X} {Y}
drill_end = G80
rapid5 = G00 {X} {Y} {Z} {A} {B} {C}
feed5 = G01 {X} {Y} {Z} {A} {B} {C} {F}
tcp_on = (TCP is provided by the machine kinematics)
tcp_off = (TCP off)
work_offset = G{wcs}
